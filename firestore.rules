rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The claim lives in the ID token; the app force-refreshes the token right after
    // verification (VerifyEmailViewModel.check(), or RootViewModel.refresh() at launch).
    function isVerifiedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    // A field is checked only when this write sets or changes it, so a legacy key or value
    // already on a document never blocks an update; removing a legacy key is always allowed.
    function isWritten(key) {
      return key in request.resource.data &&
        (resource == null || key in request.resource.data.diff(resource.data).affectedKeys());
    }

    function writesOnly(keys) {
      return resource == null
        ? request.resource.data.keys().hasOnly(keys)
        : request.resource.data.diff(resource.data).addedKeys()
            .union(request.resource.data.diff(resource.data).changedKeys())
            .hasOnly(keys);
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function hasValidProfile() {
      let data = request.resource.data;
      return writesOnly(['name', 'email', 'onboardingStep', 'currency']) &&
        isShortString(data.name, 200) &&
        isShortString(data.email, 254) &&
        (!isWritten('email') || data.email.lower() == request.auth.token.email.lower()) &&
        (!('onboardingStep' in request.resource.data) ||
          request.resource.data.onboardingStep in [
            'welcome', 'services', 'client', 'windows', 'sendSchedule', 'booking', 'finished'
          ]) &&
        (!('currency' in request.resource.data) ||
          request.resource.data.currency in ['PLN', 'UAH', 'USD', 'EUR']);
    }

    function hasValidServiceFormat() {
      let data = request.resource.data;
      return writesOnly(['name', 'price', 'isActive', 'position']) &&
        isShortString(data.name, 200) &&
        data.name.size() > 0 &&
        data.price is int &&
        data.price >= 0 &&
        (!isWritten('isActive') || data.isActive is bool) &&
        (!('position' in data) || data.position is int);
    }

    // A client needs a handle or a name; an absent field is left out, never stored empty.
    // Phone is not validated (data-layer.md).
    function hasValidClientFormat() {
      let data = request.resource.data;
      let hasInstagram = 'instagram' in data;
      let hasName = 'name' in data;
      return writesOnly(['name', 'instagram', 'phone', 'createdAt', 'lastBookedAt']) &&
        (hasInstagram || hasName) &&
        (!hasInstagram || (data.instagram is string && data.instagram.matches('^[a-z0-9._]{1,30}$'))) &&
        (!hasName || (data.name is string && data.name.size() > 0)) &&
        (!isWritten('name') || isShortString(data.name, 200)) &&
        (!isWritten('phone') || isShortString(data.phone, 20)) &&
        (!isWritten('lastBookedAt') || data.lastBookedAt is timestamp) &&
        data.createdAt is timestamp;
    }

    function hasValidSlotFormat(slotId) {
      let data = request.resource.data;
      return writesOnly(['date', 'time', 'clientId', 'serviceId', 'serviceName', 'servicePrice']) &&
        (!isWritten('clientId') || isShortString(data.clientId, 128)) &&
        (!isWritten('serviceId') || isShortString(data.serviceId, 128)) &&
        (!isWritten('serviceName') || isShortString(data.serviceName, 200)) &&
        (!isWritten('servicePrice') || (data.servicePrice is int && data.servicePrice >= 0)) &&
        data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        slotId == data.date + '_' + data.time.replace(':', '');
    }

    function hasValidEventTemplateFormat() {
      let data = request.resource.data;
      return data.keys().hasOnly(['emoji', 'name', 'isActive']) &&
        isShortString(data.emoji, 16) && data.emoji.size() > 0 &&
        isShortString(data.name, 200) && data.name.size() > 0 &&
        (!('isActive' in data) || data.isActive is bool);
    }

    function hasValidEventFormat() {
      let data = request.resource.data;
      return data.keys().hasOnly(['date', 'startTime', 'endTime', 'templateId', 'emoji', 'name']) &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.endTime is string && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.startTime < data.endTime &&
        (!('templateId' in data) || (isShortString(data.templateId, 128) && data.templateId.size() > 0)) &&
        isShortString(data.emoji, 16) && data.emoji.size() > 0 &&
        isShortString(data.name, 200) && data.name.size() > 0;
    }

    function hasValidMonthlySummaryFormat(monthId) {
      let data = request.resource.data;
      return monthId.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.keys().hasOnly(['revenue', 'visits', 'clients', 'windows', 'bookedWindows']) &&
        data.revenue is int && data.revenue >= 0 &&
        data.visits is int && data.visits >= 0 &&
        data.clients is int && data.clients >= 0 &&
        data.windows is int && data.windows >= 0 &&
        data.bookedWindows is int && data.bookedWindows >= 0;
    }

    function isMessageTextMap(texts) {
      return texts is map &&
        texts.keys().hasOnly(['uk', 'pl', 'en']) &&
        (!('uk' in texts) || isShortString(texts.uk, 1000)) &&
        (!('pl' in texts) || isShortString(texts.pl, 1000)) &&
        (!('en' in texts) || isShortString(texts.en, 1000));
    }

    function hasValidMessageTemplate(settingId) {
      let data = request.resource.data;
      return settingId == 'sendSchedule' &&
        data.keys().hasOnly(['style', 'language', 'headers', 'footers']) &&
        (!('style' in data) || data.style in ['dash', 'weekday', 'list', 'compact']) &&
        (!('language' in data) || data.language in ['uk', 'pl', 'en']) &&
        (!('headers' in data) || isMessageTextMap(data.headers)) &&
        (!('footers' in data) || isMessageTextMap(data.footers));
    }

    // Every master's data lives under her own document; only she can touch it, and only once
    // her email is verified. The one exception is creating the profile at sign-up, which
    // happens before the verification email is even sent.
    match /users/{uid} {
      allow create: if isOwner(uid) && hasValidProfile();
      allow update: if isVerifiedOwner(uid) && hasValidProfile();
      allow read, delete: if isVerifiedOwner(uid);

      match /services/{serviceId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidServiceFormat();
      }

      match /clients/{clientId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidClientFormat();
      }

      match /slots/{slotId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidSlotFormat(slotId);
      }

      match /eventTemplates/{templateId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidEventTemplateFormat();
      }

      match /events/{eventId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidEventFormat();
      }

      // A finished month is summarised once and never rewritten, so there is no update.
      match /monthlyStats/{monthId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && hasValidMonthlySummaryFormat(monthId);
      }

      // The style and language lists mirror MessageDayStyle and MessageLanguage; change them together.
      match /settings/{settingId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidMessageTemplate(settingId);
      }
    }
  }
}
