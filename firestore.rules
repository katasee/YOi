rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The claim lives in the ID token; the app force-refreshes the token right after
    // verification (VerifyEmailViewModel.check(), or RootViewModel.refresh() at launch).
    function isVerifiedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function hasValidProfile() {
      return request.resource.data.name is string &&
        request.resource.data.email is string;
    }

    function hasValidServiceFormat() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.price is int &&
        request.resource.data.price >= 0;
    }

    // A client needs a handle or a name; an absent field is left out, never stored empty.
    // Phone is not validated (data-layer.md).
    function hasValidClientFormat() {
      let data = request.resource.data;
      let hasInstagram = 'instagram' in data;
      let hasName = 'name' in data;
      return (hasInstagram || hasName) &&
        (!hasInstagram || (data.instagram is string && data.instagram.matches('^[a-z0-9._]{1,30}$'))) &&
        (!hasName || (data.name is string && data.name.size() > 0)) &&
        data.createdAt is timestamp;
    }

    function hasValidSlotFormat(slotId) {
      let data = request.resource.data;
      return data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        slotId == data.date + '_' + data.time.replace(':', '');
    }

    function hasValidEventTemplateFormat() {
      let data = request.resource.data;
      return data.keys().hasOnly(['emoji', 'name', 'isActive']) &&
        data.emoji is string && data.emoji.size() > 0 &&
        data.name is string && data.name.size() > 0 &&
        data.isActive is bool;
    }

    function hasValidEventFormat() {
      let data = request.resource.data;
      return data.keys().hasOnly(['date', 'startTime', 'endTime', 'templateId', 'emoji', 'name']) &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.endTime is string && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.startTime < data.endTime &&
        (!('templateId' in data) || (data.templateId is string && data.templateId.size() > 0)) &&
        data.emoji is string && data.emoji.size() > 0 &&
        data.name is string && data.name.size() > 0;
    }

    function hasValidMonthlySummaryFormat(monthId) {
      let data = request.resource.data;
      return monthId.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.keys().hasOnly(['revenue', 'visits', 'clients', 'windows', 'bookedWindows']) &&
        data.revenue is int && data.revenue >= 0 &&
        data.visits is int && data.visits >= 0 &&
        data.clients is int && data.clients >= 0 &&
        data.windows is int && data.windows >= 0 &&
        data.bookedWindows is int && data.bookedWindows >= 0;
    }

    // Every master's data lives under her own document; only she can touch it, and only once
    // her email is verified. The one exception is creating the profile at sign-up, which
    // happens before the verification email is even sent.
    match /users/{uid} {
      allow create: if isOwner(uid) && hasValidProfile();
      allow update: if isVerifiedOwner(uid) && hasValidProfile();
      allow read, delete: if isVerifiedOwner(uid);

      match /services/{serviceId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidServiceFormat();
      }

      match /clients/{clientId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidClientFormat();
      }

      match /slots/{slotId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidSlotFormat(slotId);
      }

      match /eventTemplates/{templateId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidEventTemplateFormat();
      }

      match /events/{eventId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidEventFormat();
      }

      // A finished month is summarised once and never rewritten, so there is no update.
      match /monthlyStats/{monthId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && hasValidMonthlySummaryFormat(monthId);
      }
    }
  }
}
